<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote name="disroot" fetch="https://git.disroot.org/fukiame" />
  <remote name="25ji" fetch="https://github.com/25ji-Telegram-de" />
  <remote name="LOS" fetch="https://github.com/LineageOS" />
  <!-- <remote name="AOS" fetch="https://github.com/ArrowOS" /> -->

  <!-- device tree -->
  <project path="device/xiaomi/blossom" name="android_device_xiaomi_blossom" remote="disroot" revision="Blooming" />

  <!-- SELinux policies -->
  <!--
  <remove-project path="device/mediatek/sepolicy_vndr"/>
  -->
  <project path="device/mediatek/sepolicy_vndr" name="android_device_mediatek_sepolicy_vndr" remote="disroot" revision="Blooming" />

  <!-- hardware supports -->
  <project path="hardware/mediatek" name="android_hardware_mediatek" remote="disroot" revision="Blooming" />
  <!--
  <project path="hardware/miku/interfaces" name="android_hardware_miku_interfaces" remote="25ji" revision="Udon_v2" />
  -->

  <!-- kernel tree -->
  <project path="device/xiaomi/blossom-kernel" name="android_device_xiaomi_blossom-kernel" remote="disroot" revision="yoka">
    <linkfile src="headers" dest="kernel/xiaomi/blossom" />
  </project>

  <!-- vendor tree -->
  <project path="vendor/xiaomi/blossom" name="proprietary_vendor_xiaomi_blossom" remote="disroot" revision="Blooming" />

  <!-- Samsung NFC
  -->
  <remove-project name="platform/hardware/samsung/nfc"/>
  <project path="hardware/samsung/nfc" name="android_hardware_samsung_nfc" remote="disroot" revision="Blooming" />

  <!-- RevampedFMRadio -->
  <!--
  <remove-project path="packages/apps/FMRadio"/>
  -->
  <project path="packages/apps/RevampedFMRadio" name="android_packages_apps_RevampedFMRadio" remote="disroot" revision="lineage-22.1" />

  <!-- libtinyxml -->
  <!--
  <project path="external/tinyxml" name="android_external_tinyxml" remote="AOS" revision="arrow-13.1" />
  -->

  <!-- FOSS Browser
       (overrides Browser2, here only for sources which
       do not ship any usable browser out of the box)
  -->
  <project path="packages/apps/FOSSBrowser" name="android_packages_apps_FOSSBrowser" remote="disroot" revision="fdroid" />

  <!-- Miku exclusive, package replacements
       for a more or less sleeker experience

       a mix of LineageOS packages and, sometimes,
       ExthmUI changes
  -->
  <remove-project path="packages/apps/Dialer"/>
  <remove-project path="packages/apps/Messaging"/>
  <remove-project path="packages/apps/Contacts"/>
  <remove-project path="packages/apps/DeskClock"/>

  <project path="packages/apps/Glimpse" name="android_packages_apps_Glimpse" remote="LOS" revision="lineage-22.2" />
  <project path="packages/apps/DeskClock" name="android_packages_apps_DeskClock" remote="LOS" revision="lineage-22.2" />
  <project path="packages/apps/Contacts" name="android_packages_apps_Contacts" remote="LOS" revision="lineage-23.0" />
  <project path="packages/apps/Messaging" name="android_packages_apps_Messaging" remote="LOS" revision="lineage-23.0" />

  <project path="packages/apps/Dialer" name="android_packages_apps_Dialer" remote="disroot" revision="Blooming" />

</manifest>
